# Preview mode is the default until the backend API is available.
VITE_DATA_MODE=preview

# Authentication mode is explicit; switch to "supabase" to enable Supabase Auth.
VITE_AUTH_MODE=preview

# Required only when VITE_DATA_MODE=api. VITE_ values are public.
VITE_API_BASE_URL=

# Supabase frontend configuration. Use only a publishable/anon key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
VITE_APP_ENV=development
